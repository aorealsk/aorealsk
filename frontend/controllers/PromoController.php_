        $lang = Yii::$app->request->get('l');
        return $this->render('register-failed',[
            'lang' => $lang,
        ]);
    }

    public function actionValidationDone(): string
    {
        $lang = Yii::$app->request->get('l');
        return $this->render('validation-done',[
            'lang' => $lang,
        ]);
    }

    public function actionValidationFailed(): string
    {
        $lang = Yii::$app->request->get('l');
        return $this->render('validation-failed',[
            'lang' => $lang,
        ]);
    }

}